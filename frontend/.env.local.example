# NEXT_PUBLIC_* values are inlined into the bundle at build time — changing one
# means restarting the dev server or rebuilding.

# Supabase → Project Settings → API.
# These exist ONLY for email + password sign-in and holding a session.
# The browser has no data path to Postgres; all data goes through the Go API.
# Never put the service_role key here — it would ship to every visitor.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Where the Go API is reachable from the browser. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8080
