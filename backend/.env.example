# ---------------------------------------------------------------- server
PORT=8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
SHUTDOWN_GRACE=15s

# ---------------------------------------------------------------- database
# Supabase → Project Settings → Database → Connection string → URI.
# Port 6543 is the transaction pooler (recommended); 5432 is a direct connection.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------- auth
# Supabase → Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Only needed if your project still signs access tokens with the legacy HS256
# secret. Projects using asymmetric JWT signing keys verify via SUPABASE_URL's
# JWKS endpoint and can leave this blank.
SUPABASE_JWT_SECRET=

SUPABASE_JWT_AUDIENCE=authenticated
