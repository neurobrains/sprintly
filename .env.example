# The API's only env file. Copy to .env and fill in.
# The frontend has its own: frontend/.env.local.example

# ---------------------------------------------------------------- server
PORT=8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
SHUTDOWN_GRACE=15s

# ---------------------------------------------------------------- supabase
# Project Settings → API → Project URL.
# Both the PostgREST data endpoint and the JWKS endpoint are derived from it.
SUPABASE_URL=https://<project-ref>.supabase.co

# Project Settings → API → service_role.
# This is the credential the entire data layer runs on. It bypasses RLS.
# Server-side only — it must never reach a browser or a build artifact.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Public. Safe in a client bundle; here only so the API can report it.
SUPABASE_ANON_KEY=<anon-key>

# Only for projects still signing tokens with the legacy HS256 secret. Leave
# blank when the current JWT signing key is asymmetric (ECC/RSA) — access tokens
# then verify through SUPABASE_URL's JWKS endpoint.
SUPABASE_JWT_SECRET=

SUPABASE_JWT_AUDIENCE=authenticated

# No DATABASE_URL: the API talks PostgREST over HTTPS, not the Postgres wire
# protocol, so there is no connection string and no database password.
